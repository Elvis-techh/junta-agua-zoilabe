# One nightly backup, then exit. Paired with zoilabe-backup.timer.
#
#   cp deploy/zoilabe-backup.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now zoilabe-backup.timer
#
# Run one now (do this once after install and read the log):
#   systemctl start zoilabe-backup && journalctl -u zoilabe-backup -n 20

[Unit]
Description=Junta de Agua Zoilabe nightly backup

[Service]
Type=oneshot
User=zoilabe
Group=zoilabe
WorkingDirectory=/opt/zoilabe/backend
# The API's settings (DATABASE_PATH), then the encryption key and the Spaces
# key, which live in .env.backup, readable only by root; the API's own .env
# does not carry them.
EnvironmentFile=/opt/zoilabe/backend/.env
EnvironmentFile=/opt/zoilabe/backend/.env.backup
ExecStart=/opt/node22/bin/node dist/scripts/backup.js

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# data: it reads the live file and files "last backup" there.
ReadWritePaths=/opt/zoilabe/backend/backups /opt/zoilabe/backend/data
UMask=0077
