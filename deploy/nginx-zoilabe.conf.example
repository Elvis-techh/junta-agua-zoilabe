# Nginx site for the Junta de Agua app, on its own subdomain beside Lindero and
# Báscula Central. Replace <SUBDOMAIN> (e.g. agua.basculacentral.com, or the
# board's own domain once it has one).
#
# Same shape as Lindero's: the built frontend as static files, /api/ proxied
# to the API on loopback port 3002. After editing: `nginx -t`, then
# `systemctl reload nginx` — never restart, the scale stations depend on it.

server {
    listen 80;
    listen [::]:80;
    server_name <SUBDOMAIN>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <SUBDOMAIN>;

    ssl_certificate     /etc/letsencrypt/live/<SUBDOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<SUBDOMAIN>/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    root /opt/zoilabe/frontend/dist;
    index index.html;

    # The service worker must never be cached, or a phone keeps the old app.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    # Every other path is a screen of the app.
    location / {
        try_files $uri /index.html;
    }
}
