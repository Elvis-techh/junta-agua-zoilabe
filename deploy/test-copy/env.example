# The test copy's settings (docs/test-copy.md). Copied to /opt/zoilabe-test/env,
# with <TEST_SUBDOMAIN> replaced by the test copy's own address. It holds no
# secret: the test copy has no backups and no storage key.

NODE_ENV=production
HOST=127.0.0.1
# 3000 is Báscula Central's, 3001 Lindero's, 3002 the real Junta de Agua's.
PORT=3003
APP_URL=https://<TEST_SUBDOMAIN>
TRUST_PROXY=127.0.0.1
DATABASE_PATH=/opt/zoilabe-test/data/zoilabe.db
