# Copy to backend/.env for local development. Never commit the real file.

NODE_ENV=development
HOST=127.0.0.1
# 3000 is Báscula Central's and 3001 is Lindero's on the shared droplet.
PORT=3002

# The address people open on their phones. Invitation links point here.
APP_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# The database: one SQLite file. Unset, it is backend/data/zoilabe.db.
# On the droplet: /opt/zoilabe/backend/data/zoilabe.db (its folder must be writable).
# DATABASE_PATH=

# Behind Nginx on the droplet: 127.0.0.1. Leave unset locally.
# TRUST_PROXY=

# Backups (src/scripts/backup.ts). Without the SPACES_* values the dump stays in backend/backups/.
# `openssl rand -base64 32` — keep a copy outside the droplet, or the backups cannot be opened.
BACKUP_ENCRYPTION_KEY=
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_PREFIX=zoilabe/backups
