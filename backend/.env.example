# Copy to backend/.env for local development. Never commit the real file.

NODE_ENV=development
HOST=127.0.0.1
# 3000 is Báscula Central's and 3001 is Lindero's on the shared droplet.
PORT=3002

# The address people open on their phones. Invitation links point here.
APP_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# What the running app connects as: can add history entries but never change them.
DATABASE_URL=postgres://zoilabe_app:zoilabe_app_dev@localhost:54329/zoilabe
# Owns the tables; used only by db:migrate, db:seed and backups.
DATABASE_ADMIN_URL=postgres://zoilabe_admin:zoilabe_admin_dev@localhost:54329/zoilabe
# Used only by db:setup and the tests, to create the database and the two logins.
# This one is the private server from `npm run db:local -- start`.
DATABASE_SUPERUSER_URL=postgres://postgres:postgres@localhost:54329/postgres

# At least 32 characters in production. `openssl rand -base64 48`
COOKIE_SECRET=zoilabe-development-cookie-secret-change-me

# Backups (scripts/backup.mjs). Without the SPACES_* values the dump stays in backend/backups/.
# `openssl rand -base64 32` — keep a copy outside the droplet, or the backups cannot be opened.
BACKUP_ENCRYPTION_KEY=
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_PREFIX=zoilabe/backups
