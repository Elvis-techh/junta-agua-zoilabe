{
  "name": "@zoilabe/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.ts",
    "db:local": "bash scripts/local-pg.sh",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx --env-file-if-exists=.env src/db/setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts",
    "db:backup": "tsx --env-file-if-exists=.env src/scripts/backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env src/scripts/restore.ts",
    "db:verify-log": "tsx --env-file-if-exists=.env src/scripts/verify-log.ts",
    "user:first-admin": "tsx --env-file-if-exists=.env src/scripts/first-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
